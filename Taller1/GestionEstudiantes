public class GestionEstudiantes {
    //Atributos 
    private int id;
    private String nombre;
    private String apellido;
    private String programaAc;
    private double calificaiones;

    //constructor
    public GestionEstudiantes(int id, String nombre, String apellido, String programaAc, double calificaiones){
